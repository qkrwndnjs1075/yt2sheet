{
  "name": "yt2sheet",
  "version": "0.2.11",
  "description": "Generate sheet-music PDFs from YouTube videos locally.",
  "type": "module",
  "bin": {
    "yt2": "dist-cli/cli/index.js"
  },
  "files": [
    "dist-cli",
    "scripts/install-cli.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "build:bundle": "node scripts/build-bundle.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "build:web": "vite build --config vite.web.config.ts",
    "build:test": "tsc -p tsconfig.test.json",
    "benchmark:score": "tsx server/benchmark/cli.ts",
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "postinstall": "node scripts/install-cli.mjs",
    "start:server": "tsx server/index.ts",
    "test": "npm run build:test && node -e \"require('fs').writeFileSync('build-test/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\" && node --test \"build-test/**/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build:cli && npm run build:web && npm run build",
    "prepack": "npm run build:cli"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.286",
    "@types/node": "^22.10.2",
    "concurrently": "9.2.4",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@hono/node-server": "^2.0.11",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.12.31",
    "ky": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  }
}
