{
  "name": "yt2sheet",
  "version": "0.2.15",
  "description": "Generate sheet-music PDFs from YouTube videos locally.",
  "type": "module",
  "bin": {
    "yt2": "dist-cli/cli/index.js"
  },
  "files": [
    "dist-cli",
    "scripts/install-cli.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:cli",
    "build:bundle": "node scripts/build-bundle.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "build:test": "node -e \"require('fs').rmSync('build-test', { recursive: true, force: true })\" && tsc -p tsconfig.test.json",
    "benchmark:score": "tsx benchmarks/cli.ts",
    "postinstall": "node scripts/install-cli.mjs",
    "test": "npm run build:test && node -e \"require('fs').writeFileSync('build-test/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\" && node --test \"build-test/**/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build:cli",
    "prepack": "npm run build:cli"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "^5.3.0",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  }
}
